<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/gromore_native_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="广告图标"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/gromore_native_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:maxLines="2"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/gromore_native_dislike"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:text="不感兴趣"
            android:textAllCaps="false"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/gromore_native_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="6dp"
        android:maxLines="3"
        android:textColor="#555555"
        android:textSize="14sp" />

    <FrameLayout
        android:id="@+id/gromore_native_media"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/gromore_native_main_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="广告图片"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <Button
        android:id="@+id/gromore_native_action"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:text="查看详情"
        android:textAllCaps="false" />
</LinearLayout>
